    HOOK -->|"Registro local via SQLite"| CATDB
    HOOK -->|"Registro Docker via HTTP"| RTC
    RTC -->|"nb_*"| CATDB
    KERNEL -->|"Tabelas Iceberg no Docker/DuckDB"| ICE
    ICE -->|"Commit com CAS"| CATDB
    KERNEL -->|"output"| KSVC
    KSVC -->|"frame output"| SPA
    SPA -->|"Renderiza"| OUT

