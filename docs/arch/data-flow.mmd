graph TB
    CELL["Célula do notebook<br/>python, sql, duckdb"]
    SPA["SPA<br/>Canal WS v1"]
    KSVC["kernels.service<br/>Backend"]
    KERNEL["Kernel<br/>Spark ou DuckDB"]
    HOOK["_notisbook_catalog<br/>Hook injetado"]
    LAYER["Regras de camada<br/>landing, bronze, silver, gold"]
    MINIO["Notislake<br/>s3a://notislake"]
    CATDB[("catalog.db<br/>nb_* e Iceberg")]
    RTC["runtime-catalog<br/>Backend"]
