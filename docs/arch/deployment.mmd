graph TB
    GH["GitHub Releases<br/>wheel, MinIO, install.sh"]

    subgraph MAC["Mac with Apple silicon"]
        BROWSER["Browser<br/>127.0.0.1:8765"]
        UVTOOL["uv tool env<br/>notisbook wheel"]
        BACKEND["notisbook process<br/>FastAPI + uvicorn"]
        MINIOBIN["MinIO binary<br/>~/.notisbook/minio/bin"]
        MINIOPROC["MinIO process<br/>Loopback dynamic ports"]
        ENVS[("Runtime envs<br/>~/.notisbook/envs")]
        DATA[("Data root<br/>~/.notisbook")]
        DIST[("MinIO package<br/>~/.local/share/notisbook")]
    end

    subgraph COLIMA["Colima VM"]
        GLUEC["notisbook-glue<br/>Container"]
    end

    GH -->|"install.sh verifies SHA256SUMS"| UVTOOL
    GH -->|"Tarball"| DIST
    UVTOOL -->|"Runs"| BACKEND
    DIST -->|"Verified install"| MINIOBIN
    MINIOBIN -->|"Supervised child"| MINIOPROC
    BROWSER -->|"HTTP, WS"| BACKEND
    BACKEND -->|"Kernel processes"| ENVS
    BACKEND -->|"State"| DATA
    BACKEND -->|"Docker CLI"| GLUEC
    GLUEC -->|"host.lima.internal"| BACKEND

    classDef external    fill:#FFFFFF,stroke:#F97316,stroke-width:2px,color:#7C2D12
