graph TB
    CLIENT["Interface web<br/>REST e WebSocket"]

    subgraph BACKEND["Servidor Notisbook"]
        SEC["security<br/>Token, Host, Origin"]
        STATIC["static<br/>SPA e CSP"]
        RCONT["api.contents<br/>Notebooks"]
        RROOT["api.notebooks_root<br/>Raiz e geração"]
        RSESS["api.sessions<br/>Sessões e canal WS"]
        RVARS["api.variables<br/>Variáveis do kernel"]
        RCAT["api.catalog<br/>Schemas e tabelas"]
        RSPARK["api.spark<br/>Versões e pacotes"]
        RJOBS["api.jobs<br/>Status e eventos"]
        REXP["api.export<br/>py, ipynb, html"]
        RFILES["api.files<br/>Pastas e seletor"]
        RSYS["api.system<br/>Health e recursos"]
        STORE["NotebookStore<br/>Raiz única"]
        PREFS["preferences<br/>Validação da raiz"]
        KSVC["KernelService<br/>jupyter_client"]
        INST["SparkInstaller<br/>Ambientes versionados"]
        VCAT["CatalogService<br/>Versões via PyPI"]
        JOBREG["JobRegistry<br/>Eventos em memória"]
        CATPKG["catalog<br/>store, schemas, registry"]
        EXPORT["export<br/>Conversores puros"]
        FSB["files<br/>browser, native_picker"]
        PREREQS["spark.prereqs<br/>uv e JDK"]
    end

    CATDB[("catalog.db<br/>SQLite")]
    NBDIR[("Notebooks<br/>.ipynb")]
    KERNELS["Kernels IPython<br/>Processos locais"]

    CLIENT -->|"Requisições"| SEC
    CLIENT -->|"GET páginas"| STATIC
    SEC -->|"Autoriza"| RCONT
    SEC -->|"Autoriza"| RSESS
    SEC -->|"Autoriza"| RSPARK
    SEC -->|"Autoriza"| RCAT
    RCONT -->|"Lê e grava"| STORE
    RROOT -->|"Valida e persiste"| PREFS
    RROOT -->|"Troca raiz"| STORE
    RSESS -->|"Inicia e executa"| KSVC
    RVARS -->|"Sondas silenciosas"| KSVC
    RSPARK -->|"Instala e remove"| INST
    RSPARK -->|"Lista versões"| VCAT
    INST -->|"Publica progresso"| JOBREG
    RJOBS -->|"Lê eventos"| JOBREG
    RCAT -->|"Sem SparkSession"| CATPKG
    REXP -->|"Converte"| EXPORT
    RFILES -->|"Metadados"| FSB
    RSYS -->|"Pré-requisitos"| PREREQS
    INST -->|"Confere uv e JDK"| PREREQS
    STORE -->|"Escrita atômica"| NBDIR
    CATPKG -->|"SQL"| CATDB
    KSVC -->|"ZMQ"| KERNELS

    classDef external    fill:#FFFFFF,stroke:#F97316,stroke-width:2px,color:#7C2D12
    classDef integration fill:#FFFFFF,stroke:#6366F1,stroke-width:2px,color:#312E81
    classDef processing  fill:#FFFFFF,stroke:#22C55E,stroke-width:2px,color:#14532D
    classDef persistence fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#7F1D1D
    classDef support     fill:#FFFFFF,stroke:#38BDF8,stroke-width:2px,color:#075985

    class CLIENT,KERNELS external
    class SEC,STATIC integration
    class RCONT,RROOT,RSESS,RVARS,RCAT,RSPARK,RJOBS,REXP,RFILES,RSYS,STORE,PREFS,KSVC,INST,VCAT,JOBREG,CATPKG,EXPORT,FSB,PREREQS processing
    class CATDB,NBDIR persistence
